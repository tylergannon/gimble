                "not": {
                  "enum": [
                    "success",
                    "failure"
                  ]
                },
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "llm_model": {
                "type": "string"
              },
              "llm_provider": {
                "type": "string"
              },
              "max_retries": {
                "type": "integer"
              },
              "max_visits": {
                "type": "integer"
              },
              "prompt": {
                "type": "string"
              },
              "reasoning_effort": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "thread_id": {
                "type": "string"
              },
              "timeout": {
                "description": "Duration is an integer followed by ms, s, m, h, or d.",
                "pattern": "^[0-9]+(ms|s|m|h|d)$",
                "type": "string"
              },
