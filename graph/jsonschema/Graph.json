                "type": "string"
              },
              "type": {
                "const": "agent",
                "type": "string"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "FanOutNode concurrently walks each outgoing branch.",
            "properties": {
              "branch_edges": {
                "items": {
                  "additionalProperties": false,
                  "description": "Edge is an outgoing transition owned by its origin node.",
                  "properties": {
                    "condition": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "to"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "branches": {
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "additionalProperties": false,
                      "description": "FanOutBranch is either a legacy branch-root reference or a synthesized agent branch with declared output artifacts.",
                      "properties": {
                        "agent": {
                          "additionalProperties": false,
                          "description": "AgentOverride selectively replaces fields inherited from a fan-out node's agent configuration. Every field is optional by design.",
