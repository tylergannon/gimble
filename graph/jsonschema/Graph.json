                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "llm_model": {
                "type": "string"
              },
              "llm_provider": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "reasoning_effort": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
