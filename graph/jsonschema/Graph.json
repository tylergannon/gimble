          {
            "additionalProperties": false,
            "description": "LoopNode iterates a checklist file: on every arrival it validates the previous lap's item, then an evaluator decides whether the definition of done is met or another open item should be dispatched.",
            "properties": {
              "checklist": {
                "description": "Checklist is the checklist path, relative to the workdir. Optional only when this loop node lies inside another loop's body, in which case it iterates the enclosing item's checklist field.",
                "type": "string"
              },
              "edges": {
                "additionalProperties": false,
                "description": "Edges are the engine-known routes for another lap and for leaving the loop.",
                "properties": {
                  "exit": {
                    "type": "string"
                  },
                  "loop": {
                    "type": "string"
                  }
                },
                "required": [
                  "loop",
                  "exit"
                ],
                "type": "object"
              },
              "evaluator_llm_model": {
                "description": "EvaluatorLLMModel selects the model used by the loop evaluator.",
                "type": "string"
              },
              "evaluator_llm_provider": {
                "description": "EvaluatorLLMProvider selects the provider used by the loop evaluator.",
                "type": "string"
              },
              "evaluator_reasoning_effort": {
                "description": "EvaluatorReasoningEffort sets the loop evaluator's reasoning effort.",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "id": {
                "not": {
                  "enum": [
                    "success",
                    "failure"
                  ]
                },
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "llm_model": {
                "description": "LLMModel selects the model used by the infer judge.",
                "type": "string"
              },
              "llm_provider": {
                "description": "LLMProvider selects the provider used by the infer judge.",
                "type": "string"
              },
              "max_visits": {
                "description": "MaxVisits bounds arrivals at the loop node, laps plus one.",
                "type": "integer"
              },
              "reasoning_effort": {
                "description": "ReasoningEffort sets the reasoning effort of the infer judge.",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "timeout": {
                "description": "Timeout bounds one item's validation command, the infer judge turn, and the evaluator turn.",
                "pattern": "^[0-9]+(ms|s|m|h|d)$",
                "type": "string"
