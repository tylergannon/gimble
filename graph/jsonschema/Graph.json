            "required": [
              "type",
              "id",
              "branches"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "FanInNode evaluates parallel branch evidence with an LLM turn.",
            "properties": {
              "edges": {
                "items": {
                  "additionalProperties": false,
                  "description": "Edge is an outgoing transition owned by its origin node.",
                  "properties": {
                    "condition": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "to"
                  ],
                  "type": "object"
                },
