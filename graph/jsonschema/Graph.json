    "defaults": {
      "additionalProperties": false,
      "description": "Defaults contains file-level defaults for node fields.",
      "properties": {
        "fidelity": {
          "type": "string"
        },
        "llm_model": {
          "type": "string"
        },
        "llm_provider": {
          "type": "string"
        },
        "max_retries": {
          "type": "integer"
        },
        "reasoning_effort": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        "timeout": {
          "description": "Duration is an integer followed by ms, s, m, h, or d.",
          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "goal": {
      "description": "Goal is the pipeline objective exposed to prompt expansion.",
      "type": "string"
    },
    "name": {
      "description": "Name is the pipeline's display name.",
      "type": "string"
    },
    "nodes": {
      "description": "Nodes is the graph. Each node carries its outgoing edges.",
