                "const": "fan_in",
                "type": "string"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "CommandNode executes one shell command.",
            "properties": {
              "command": {
                "type": "string"
