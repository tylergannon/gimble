                  "error": {
                    "type": "string"
                  },
                  "success": {
                    "type": "string"
                  }
                },
                "required": [
                  "success"
                ],
                "type": "object"
              },
              "id": {
                "not": {
                  "enum": [
                    "success",
                    "failure"
                  ]
