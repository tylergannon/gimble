                            "fidelity": {
                              "type": "string"
                            },
                            "label": {
                              "type": "string"
                            },
                            "llm_model": {
                              "type": "string"
                            },
                            "llm_provider": {
                              "type": "string"
                            },
                            "max_retries": {
                              "type": "integer"
                            },
                            "max_visits": {
                              "type": "integer"
                            },
                            "prompt": {
                              "type": "string"
                            },
                            "reasoning_effort": {
                              "enum": [
                                "low",
                                "medium",
                                "high"
                              ],
                              "type": "string"
                            },
                            "thread_id": {
                              "type": "string"
                            },
                            "timeout": {
                              "description": "Duration is an integer followed by ms, s, m, h, or d.",
                              "pattern": "^[0-9]+(ms|s|m|h|d)$",
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "artifacts": {
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "id": {
                          "not": {
                            "enum": [
                              "success",
                              "failure"
                            ]
                          },
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "artifacts"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "type": "array"
              },
              "fidelity": {
                "type": "string"
              },
              "id": {
                "not": {
                  "enum": [
                    "success",
                    "failure"
                  ]
                },
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "llm_model": {
                "type": "string"
              },
              "llm_provider": {
                "type": "string"
              },
              "max_parallel": {
                "type": "integer"
              },
              "max_retries": {
                "type": "integer"
              },
              "max_visits": {
                "type": "integer"
              },
              "prompt": {
                "type": "string"
              },
              "reasoning_effort": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "thread_id": {
                "type": "string"
              },
              "timeout": {
                "description": "Duration is an integer followed by ms, s, m, h, or d.",
                "pattern": "^[0-9]+(ms|s|m|h|d)$",
                "type": "string"
              },
              "type": {
                "const": "fan_out",
                "type": "string"
              },
              "workspace": {
                "description": "WorkspacePolicy controls whether parallel branches receive separate Git worktrees or run together in the caller's workspace.",
                "enum": [
                  "isolated",
                  "shared"
                ],
                "type": "string"
              }
